{
  "name": "meditacoes-biblicas",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:data": "node scripts/generate-build-data.mjs",
    "prestart": "npm run generate:data",
    "start": "ng serve",
    "prebuild": "npm run generate:data",
    "build": "ng build",
    "postbuild": "cp dist/meditacoes-biblicas/browser/index.html dist/meditacoes-biblicas/browser/404.html",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:data",
    "test": "ng test",
    "predeploy": "npm run build -- --configuration production --base-href /meditacoes-biblicas/",
    "deploy": "npx angular-cli-ghpages --dir=dist/meditacoes-biblicas/browser",
    "serve:ssr:meditacoes-biblicas": "node dist/meditacoes-biblicas/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/platform-server": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@angular/ssr": "^21.2.19",
    "bootstrap": "^5.3.8",
    "express": "^4.18.2",
    "marked": "^15.0.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "angular-cli-ghpages": "^3.0.2",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  }
}